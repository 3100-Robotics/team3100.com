---
import TeamPhoto from "../assets/team-photo-regional-1.png";
---

<div class="py-5 text-center">
    <div class="row align-items-start">
        <div class="col">
            <img src={TeamPhoto.src} />
        </div>
        <div class="col">
            <h1 class="display-5 fw-bold">Team 3100 — The Lightning Turtles</h1>
            <p class="lead col-lg-8 mx-auto">
                We are a FIRST Robotics Competition team from Two Rivers HS in
                Mendota Heights, MN.
            </p>
            <div class="d-flex gap-2 justify-content-center mt-4">
                <a href="/about" class="btn btn-primary btn-lg">About Us</a>
                <a href="/donate" class="btn btn-outline-secondary btn-lg"
                    >Support the Team</a
                >
            </div>
        </div>
    </div>
</div>
